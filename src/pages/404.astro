---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="La página que busca no existe o fue movida.">
  <section class="seccion centrado">
    <div class="contenedor">
      <span class="antetitulo">Error 404</span>
      <h1>No encontramos esta página</h1>
      <p class="texto-suave" style="max-width:52ch;margin:0 auto 30px;">
        Es posible que el enlace esté equivocado o que la página haya cambiado de dirección.
      </p>
      <a class="boton boton--primario" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>
