---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import { sitio } from '../data/sitio';
---

<Base
  titulo="Contacto"
  descripcion={`Contacte al Centro Cebien en ${sitio.direccion.calle}, ${sitio.direccion.ciudad}. Teléfono ${sitio.telefono.fijo}, WhatsApp ${sitio.telefono.celular}.`}
  ruta="/contacto"
>
  <Encabezado
    antetitulo="Contacto"
    titulo="Estamos para atenderle"
    bajada="Escríbanos, llámenos o visítenos en nuestras dependencias en pleno centro de Concepción."
    imagen="/img/encabezados/contacto.webp"
  />

  <section class="seccion">
    <div class="contenedor contacto">
      <div class="contacto__datos">
        <h2>Datos de contacto</h2>

        <ul class="datos">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
            <div>
              <strong>Dirección</strong>
              <a href={sitio.direccion.mapa} target="_blank" rel="noopener">
                {sitio.direccion.calle}, {sitio.direccion.ciudad}
              </a>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-1.527 2.11a11.422 11.422 0 0 1-5.26-5.26l2.11-1.527a1.125 1.125 0 0 0 .417-1.173L6.113 4.59c-.124-.5-.575-.852-1.091-.852H3.75A2.25 2.25 0 0 0 1.5 6.75Z"/></svg>
            <div>
              <strong>Teléfonos</strong>
              <a href={`tel:${sitio.telefono.fijoLink}`}>{sitio.telefono.fijo}</a><br />
              <a href={`tel:${sitio.telefono.celularLink}`}>{sitio.telefono.celular}</a>
            </div>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
            <div>
              <strong>Correo</strong>
              <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
            </div>
          </li>
        </ul>

        <a class="boton boton--primario" href={`https://wa.me/${sitio.telefono.whatsapp}`} target="_blank" rel="noopener">
          Escribir por WhatsApp
        </a>
      </div>

      <div class="contacto__formulario">
        <h2>Envíenos un mensaje</h2>
        <p class="texto-suave">
          Complete el formulario y le responderemos a la brevedad en horario de atención. Por favor
          no incluya información clínica detallada en este formulario.
        </p>

        <form class="formulario" action="/enviar.php" method="post">
          <div class="campo">
            <label for="nombre">Nombre y apellido</label>
            <input type="text" id="nombre" name="nombre" required autocomplete="name" />
          </div>

          <div class="campo-doble">
            <div class="campo">
              <label for="email">Correo electrónico</label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div class="campo">
              <label for="telefono">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" autocomplete="tel" />
            </div>
          </div>

          <div class="campo">
            <label for="motivo">Motivo de consulta</label>
            <select id="motivo" name="motivo">
              <option>Agendar una hora</option>
              <option>Consulta sobre convenios y coberturas</option>
              <option>Consulta administrativa</option>
              <option>Otro</option>
            </select>
          </div>

          <div class="campo">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
          </div>

          <!-- Campo trampa contra envíos automáticos: debe quedar vacío -->
          <div class="trampa" aria-hidden="true">
            <label for="sitio-web">No complete este campo</label>
            <input type="text" id="sitio-web" name="sitio_web" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="boton boton--primario">Enviar mensaje</button>

          <p class="nota">
            Al enviar este formulario acepta que sus datos sean usados para responder su consulta.
          </p>
        </form>
      </div>
    </div>

    <div class="contenedor">
      <div class="mapa">
        <iframe
          src={sitio.direccion.mapaEmbed}
          title={`Ubicación de ${sitio.nombre} en ${sitio.direccion.calle}`}
          width="100%"
          height="420"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .contacto {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 56px;
    align-items: start;
    margin-bottom: 56px;
  }

  .datos { list-style: none; margin: 0 0 28px; padding: 0; }
  .datos li { display: flex; gap: 16px; margin-bottom: 26px; }
  .datos svg { width: 22px; height: 22px; color: var(--azul-600); flex-shrink: 0; margin-top: 3px; }
  .datos strong { display: block; color: var(--tinta); margin-bottom: 3px; }
  .datos a { color: var(--texto); }
  .datos a:hover { color: var(--azul-700); }
  .horario { display: block; color: var(--texto-suave); font-size: .95rem; }

  .contacto__formulario {
    background: var(--fondo-alt);
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    padding: 32px;
  }
  .contacto__formulario > p { margin-bottom: 26px; font-size: .95rem; }

  .campo { margin-bottom: 18px; }
  .campo-doble { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label {
    display: block;
    margin-bottom: 6px;
    font-size: .88rem;
    font-weight: 600;
    color: var(--tinta);
  }
  input, select, textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--borde);
    border-radius: 10px;
    background: #fff;
    font-family: inherit;
    font-size: .97rem;
    color: var(--tinta);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--azul);
    box-shadow: 0 0 0 3px var(--azul-100);
  }
  textarea { resize: vertical; }

  .trampa { position: absolute; left: -9999px; }
  .formulario .boton { width: 100%; margin-top: 6px; }
  .nota { font-size: .82rem; color: var(--texto-suave); margin: 14px 0 0; text-align: center; }

  .mapa {
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    overflow: hidden;
    line-height: 0;
  }

  @media (max-width: 900px) {
    .contacto { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 520px) {
    .campo-doble { grid-template-columns: 1fr; }
    .contacto__formulario { padding: 24px; }
  }
</style>
