---
interface Props {
  nombre: string;
  cargo: string;
  detalle?: string;
  foto?: string;
}
const { nombre, cargo, detalle, foto } = Astro.props;
const iniciales = nombre
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0])
  .join('')
  .toUpperCase();
---

<article class="profesional">
  <div class="profesional__foto">
    {foto
      ? <img src={foto} alt={`Fotografía de ${nombre}`} width="560" height="700" loading="lazy" />
      : <span class="profesional__iniciales" aria-hidden="true">{iniciales}</span>}
  </div>
  <h3>{nombre}</h3>
  <p>{cargo}</p>
  {detalle && <p class="profesional__detalle">{detalle}</p>}
</article>

<style>
  .profesional {
    text-align: center;
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    overflow: hidden;
    padding-bottom: 22px;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .profesional:hover { border-color: var(--azul); box-shadow: var(--sombra); }

  .profesional__foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    margin: 0 0 18px;
    overflow: hidden;
    background: linear-gradient(140deg, var(--azul-100), var(--verde-100));
    display: grid;
    place-items: center;
  }
  .profesional__foto img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .profesional__iniciales {
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--azul-700);
    letter-spacing: .02em;
  }

  .profesional h3, .profesional p { padding-inline: 16px; }
  .profesional h3 { font-size: 1.05rem; margin-bottom: .25em; }
  .profesional p { font-size: .89rem; color: var(--texto-suave); margin: 0; }
  .profesional .profesional__detalle { color: var(--azul-700); font-weight: 600; margin-top: 2px; }
</style>
